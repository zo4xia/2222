# === Fish Audio TTS ===
# 多 Key 用逗号分隔，轮询使用
FISH_AUDIO_API_KEY=
FISH_AUDIO_API_KEYS=

# === Proxy Security Controls ===
# CORS 允许的源，逗号分隔（默认空 = 同源访问）
CORS_ORIGINS=

# 上游 LLM/TTS 域名白名单，逗号分隔（默认空 = 放行所有，存在 SSRF 风险）
# 建议生产环境必须设置
UPSTREAM_HOSTS=api.openai.com,api.anthropic.com,api.fish.audio

# === Environment ===
NODE_ENV=development
PORT=3001
