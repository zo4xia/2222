# ─────────────────────────────────────────────────────────────────────────────
# 环境变量登记表（Task 18 env 统一化）
#
# 优先级：前端 UI 用户填写（localStorage）> 平台注入 env > 本 .env 文件 > 内置默认
# 全部变量留空 = 使用内置默认预设（loomex 测试配置 + Fish Audio 内置池），行为与
# 历史版本完全一致；本文件只是部署方批量预设的通道。
#
# 加载机制：
#   - vite dev / build：vite.config.js loadEnv 桥自动读取本目录 .env / .env.local
#     （AI_* 四变量经 define 桥编译进前端 bundle；其余变量回写 process.env 喂 dev 插件）
#   - productionServer.js（独立 node 进程）：server/loadDotEnv.js 自动读取本文件
#   - Vercel / Zeabur / Docker：平台控制台注入即生效，优先级高于本文件
# ─────────────────────────────────────────────────────────────────────────────

# ── AI 上游（识别 / Agent B / Check 三链共用） ──
# AI_API_ENDPOINT 必须是完整 Chat Completions URL，服务端不自动拼接 /chat/completions
# AI_API_KEY 支持逗号分隔多枚自动轮询
# ⚠ 备选端点坑注：newapi.prorisehub.com 的 Gemini 渠道是原生协议直通，
#   不认 OpenAI 格式字段（messages/max_tokens 实测 400）且国内不可达——勿用于本项目的 Gemini 模型
AI_API_ENDPOINT=
AI_API_MODEL=
# Check 专用模型，留空时回退 AI_API_MODEL
AI_CHECK_MODEL=
AI_API_KEY=

# ── Fish Audio TTS ──
# FISH_AUDIO_API_KEYS 逗号分隔多枚自动轮询；设了任一 key 即完全替代内置 key 池
# FISH_AUDIO_API_KEY 单数旧名兼容（与复数并存时合并、单数优先）
FISH_AUDIO_API_KEYS=
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=
FISH_AUDIO_REFERENCE_ID=
# 留空 = https://api.fish.audio
FISH_AUDIO_API_BASE_URL=
